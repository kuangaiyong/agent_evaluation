# 运维提示：docker compose up -d api 重建后，需 docker compose restart web 刷新 nginx 的 api 解析（否则 502）
# 后端
DATABASE_URL=postgresql+psycopg2://agenteval:agenteval@db:5432/agenteval
JWT_SECRET=change-me-in-prod-please
# LLM-as-Judge：配置后走真实 OpenAI 兼容接口，留空使用内置 Mock Judge（离线可跑）
LLM_API_BASE=
LLM_API_KEY=
LLM_JUDGE_MODEL=qwen-max
JUDGE_DAILY_LIMIT_YUAN=50
GATE_WEBHOOK_URL=
GATE_WEBHOOK_SECRET=
AUTO_EVAL_INTERVAL=5
# 前端（本地开发时使用）
VITE_API_BASE=/api
